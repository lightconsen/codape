/target/
**/*.rs.bk
*.pdb


cc-src/
claurst/
kimi-cli/
qwen-code/
gemini-cli/
export_env.*.sh
!export_env.local.sh

# Local configuration and generated docs
.codape/
.claude/settings.json
# Local working checklists (diff.local.md, 11.local.md, ...). They are not part
# of the project and may hold internal notes; the developer's global ignore is
# not enough once the repository is shared or published.
*.local.md

# Agent and session worktrees
.claude/worktrees/
screenshot/

# LLVM coverage profile fragments from child processes
*.profraw
*.profdata

# libFuzzer-generated corpus entries (SHA-1 names); committed seeds are seed.txt
fuzz/corpus/*/[0-9a-f]*
fuzz/target/
fuzz/artifacts/

# Python bytecode from helper scripts
__pycache__/
*.pyc

# A stray shell redirect (`cmd > 1`) in a crate directory. `1` is never a
# source file, so ignore it rather than committing a multi-megabyte transcript.
crates/cli/1

# Local secrets (provider API keys). The benchmark runners read the key from
# the environment; `.env` is only a developer convenience and must never be
# committed.
.env
